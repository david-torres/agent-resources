{{> breadcrumbs}}
<h2 class="title is-2">Characters</h2>
<div class="buttons">
  <a href="/characters/new" class="button is-primary">Create New Character</a>
  <a href="/characters/import" class="button is-info">Import Character</a>
</div>

{{#if characters.length}}
<div class="block table-container">
  <table class="table is-fullwidth is-striped is-hoverable" x-data="sortableTable()">
    <thead>
      <tr>
        <th data-sort-key="name" @click="sortBy('name', 'string')">
          Name <span class="sort-indicator" :class="indicatorClass('name')" x-text="indicator('name')"></span>
        </th>
        <th data-sort-key="class" @click="sortBy('class', 'string')">
          Class <span class="sort-indicator" :class="indicatorClass('class')" x-text="indicator('class')"></span>
        </th>
        <th data-sort-key="level" @click="sortBy('level', 'number')">
          Level <span class="sort-indicator" :class="indicatorClass('level')" x-text="indicator('level')"></span>
        </th>
        <th data-sort-key="edition" @click="sortBy('edition', 'string')">
          Edition <span class="sort-indicator" :class="indicatorClass('edition')" x-text="indicator('edition')"></span>
        </th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each characters}}
      <tr>
        <td data-sort-value="{{this.name}}">
          <span class="title is-4">
            <a href="/characters/{{this.id}}/{{this.name}}">{{this.name}}</a>
            {{> private-badge isPublic=this.is_public}}
            {{#if this.is_deceased}}
            <span class="icon has-text-grey" title="Deceased"><i class="fas fa-skull"></i></span>
            {{/if}}
          </span>
        </td>
        <td data-sort-value="{{this.class}}">{{this.class}}</td>
        <td data-sort-value="{{this.level}}">{{this.level}}</td>
        <td data-sort-value="{{#if this.linked_class}}{{this.linked_class.rules_edition}} {{this.linked_class.rules_version}}{{/if}}">
          {{#if this.linked_class}}
          {{capitalize this.linked_class.rules_edition}} {{this.linked_class.rules_version}}
          {{else}}
          <span class="has-text-grey-light">—</span>
          {{/if}}
        </td>
        <td>
          <div class="buttons are-small">
            <a href="/characters/{{this.id}}/{{this.name}}" class="button is-light">View</a>
            <a href="/characters/{{this.id}}/edit" class="button is-warning">Edit</a>
            <button class="button is-danger" hx-delete="/characters/{{this.id}}" hx-target="closest tr"
              hx-swap="outerHTML" hx-confirm="Are you sure you want to delete this character?">Delete</button>
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<div class="notification is-light has-text-centered">
  <p class="mb-3"><span class="icon is-large has-text-grey-light"><i class="fas fa-users fa-2x"></i></span></p>
  <p class="is-size-5 mb-2">No characters yet</p>
  <p class="mb-4">Create an Enclave character to track stats, signature gear, abilities, and mission history.</p>
  <div class="buttons is-centered">
    <a href="/characters/new" class="button is-primary">Create Your First Character</a>
    <a href="/characters/import" class="button is-info is-outlined">Import Character</a>
  </div>
</div>
{{/if}}
