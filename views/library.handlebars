{{> breadcrumbs}}
<div class="level">
  <div class="level-left">
    <h1 class="title is-2">Library</h1>
  </div>
  <div class="level-right">
    {{#if isAdmin}}
    <a class="button is-primary" href="/library/manage">
      <span class="icon"><i class="fas fa-sliders"></i></span>
      <span>Manage Rules PDFs</span>
    </a>
    {{/if}}
  </div>
</div>

<div class="library-intro content mb-5">
  <p class="is-size-5">Here you will find all the information about the Enclave that you may require.</p>
  <p>Start with the free Quickstart, then turn to Advent for the full rules. Aspirant expands on that foundation with new class, advanced mechanics, and various updates to Advent mechanics.</p>
</div>

<nav class="buttons mb-5" aria-label="Library sections">
  <a class="button is-light" href="#quickstart">1. Quickstart</a>
  <a class="button is-light" href="#advent">2. Advent</a>
  <a class="button is-light" href="#aspirant">3. Aspirant</a>
  <a class="button is-light" href="#reference">Reference materials</a>
</nav>

{{#each librarySections}}
<section id="{{id}}" class="library-section library-section--{{id}}" aria-labelledby="{{id}}-title">
  <div class="library-section-heading">
    <p class="library-eyebrow">{{label}}</p>
    <h2 id="{{id}}-title" class="title is-3">{{title}}</h2>
    <p class="library-description">{{description}}</p>
    {{#if note}}<p class="library-note">{{note}}</p>{{/if}}
  </div>
  <div class="library-books">
    {{#each groups}}
      {{> library-book}}
    {{else}}
      <p class="is-size-7">No PDFs available in this section yet.</p>
    {{/each}}
  </div>
</section>
{{/each}}

<div class="box library-sheets">
  <h2 class="title is-5">Character Sheets</h2>
  <div class="buttons">
    <a class="button is-link" href="https://ndneltuukvijkvdfaqfu.supabase.co/storage/v1/object/public/misc/Character%20Sheet%20(Fillable).pdf" target="_blank" rel="noopener noreferrer">
      <span class="icon"><i class="fas fa-file-pdf"></i></span>
      <span>Fillable Character Sheet</span>
    </a>
    <a class="button is-link is-outlined" href="https://ndneltuukvijkvdfaqfu.supabase.co/storage/v1/object/public/misc/Character%20Sheet%20(Printable).pdf" target="_blank" rel="noopener noreferrer">
      <span class="icon"><i class="fas fa-file-pdf"></i></span>
      <span>Printable Character Sheet</span>
    </a>
  </div>
</div>
