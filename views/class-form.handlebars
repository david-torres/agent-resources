{{> breadcrumbs}}
<h2 class="title is-3">{{#if isNew}}Create New Class{{else}}Edit Class{{/if}}</h2>
<form hx-{{#if isNew}}post{{else}}put{{/if}}="/classes{{#unless isNew}}/{{class.id}}{{/unless}}" hx-encoding="multipart/form-data" enctype="multipart/form-data">
  <div class="columns is-multiline">
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-rules-edition">Rules Edition</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="rules_edition" id="class-rules-edition">
              <option value="advent" {{#if (eq class.rules_edition "advent")}}selected{{/if}}>Advent</option>
              <option value="aspirant" {{#if (eq class.rules_edition "aspirant")}}selected{{/if}}>Aspirant</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-content-format">Content Format</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="content_format" id="class-content-format">
              <option value="advent" {{#if (eq class.content_format "advent")}}selected{{/if}}>Advent</option>
              <option value="aspirant" {{#if (eq class.content_format "aspirant")}}selected{{/if}}>Aspirant</option>
            </select>
          </div>
        </div>
        <p class="help">Advent classes print six Signatures and three Abilities; Aspirant classes print twelve Signatures, three Core and three Advanced.</p>
      </div>
    </div>
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-rules-version">Rules Version</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="rules_version" id="class-rules-version">
              <option value="v1" {{#if (eq class.rules_version "v1")}}selected{{/if}}>v1</option>
              <option value="v2" {{#if (eq class.rules_version "v2")}}selected{{/if}}>v2</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-status">Status</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="status" id="class-status">
              {{#if (eq profile.role 'admin')}}
              <option value="release" {{#if (eq class.status "release")}}selected{{/if}}>Release</option>
              {{/if}}
              <option value="beta" {{#if (eq class.status "beta")}}selected{{/if}}>Beta</option>
              <option value="alpha" {{#if (eq class.status "alpha")}}selected{{/if}}>Alpha</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    {{!-- Admin-only: prerelease_section is provenance -- which section of the
          source document a class was printed under -- and a player-created
          class must not be able to tag itself with one. --}}
    {{#if (eq profile.role 'admin')}}
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-challenge-level">Challenge Level</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="challenge_level" id="class-challenge-level">
              <option value="">Not set</option>
              <option value="Low" {{#if (eq class.challenge_level "Low")}}selected{{/if}}>Low</option>
              <option value="Mid" {{#if (eq class.challenge_level "Mid")}}selected{{/if}}>Mid</option>
              <option value="High" {{#if (eq class.challenge_level "High")}}selected{{/if}}>High</option>
            </select>
          </div>
        </div>
        <p class="help">How demanding the class is to play well.</p>
      </div>
    </div>
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-prerelease-section">Pre-release Section</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="prerelease_section" id="class-prerelease-section">
              <option value="">Not set</option>
              <option value="pcc" {{#if (eq class.prerelease_section "pcc")}}selected{{/if}}>PCCs</option>
              <option value="exclusive" {{#if (eq class.prerelease_section "exclusive")}}selected{{/if}}>Exclusives</option>
              <option value="aspirant" {{#if (eq class.prerelease_section "aspirant")}}selected{{/if}}>Aspirant Classes</option>
            </select>
          </div>
        </div>
        <p class="help">Which section of the pre-release bundle this class was printed under.</p>
      </div>
    </div>
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-designer">Designer</label>
        <div class="control">
          <input class="input" type="text" name="designer" id="class-designer" value="{{class.designer}}">
        </div>
      </div>
    </div>
    {{/if}}
  </div>
  <div class="field">
    {{#if (eq profile.role 'admin')}}
      <label class="label">Type</label>
      <div class="control">
        <label class="radio">
          <input type="radio" name="is_player_created" value="false" {{#unless isNew}}{{#unless class.is_player_created}}checked{{/unless}}{{/unless}}>
          Official
        </label>
        <label class="radio">
          <input type="radio" name="is_player_created" value="true" {{#if isNew}}checked{{else}}{{#if class.is_player_created}}checked{{/if}}{{/if}}>
          PCC (player-created)
        </label>
      </div>
      
    {{else}}
      <input type="hidden" name="is_player_created" value="true">
    {{/if}}
  </div>
  <div class="field">
    <label class="label" for="class-name">Name</label>
    <div class="control">
      <input class="input" type="text" name="name" id="class-name" placeholder="Class Name" value="{{class.name}}" required>
    </div>
  </div>
  <div class="field">
    <label class="label" for="class-teaser">Teaser</label>
    <div class="control">
      <textarea class="textarea" name="teaser" id="class-teaser" placeholder="Short description for class list display (optional)" data-toast-editor data-editor-height="150px">{{class.teaser}}</textarea>
    </div>
  </div>
  <div class="columns is-multiline">
    <div class="column is-two-thirds-tablet">
      <div class="field">
        <label class="label" for="class-quote">Quote</label>
        <div class="control">
          <input class="input" type="text" name="quote" id="class-quote" value="{{class.quote}}">
        </div>
      </div>
    </div>
    <div class="column is-one-third-tablet">
      <div class="field">
        <label class="label" for="class-quote-source">Quote Source</label>
        <div class="control">
          <input class="input" type="text" name="quote_source" id="class-quote-source" value="{{class.quote_source}}">
        </div>
      </div>
    </div>
  </div>
  {{!-- The prose fields below are plain textareas on purpose: their text is a
        verbatim copy of the pre-release document, and a ToastUI editor would
        rewrite it through getMarkdown() on submit. --}}
  <div class="field">
    <label class="label" for="class-overview">Overview</label>
    <div class="control">
      <textarea class="textarea" name="overview" id="class-overview" rows="6" placeholder="What the class is and how it plays">{{class.overview}}</textarea>
    </div>
    <p class="help">The main prose block. Shown on the class page and used by the character creator wizard.</p>
  </div>
  <div class="field">
    <label class="label" for="class-conduit-notes">Conduit Notes</label>
    <div class="control">
      <textarea class="textarea" name="conduit_notes" id="class-conduit-notes" rows="4" placeholder="Guidance for the Conduit running this class (optional)">{{class.conduit_notes}}</textarea>
    </div>
  </div>
  <div class="field">
    <label class="label" for="class-grounding">Grounding</label>
    <div class="control">
      <textarea class="textarea" name="grounding" id="class-grounding" rows="4" placeholder="Where the class sits in the setting (optional)">{{class.grounding}}</textarea>
    </div>
  </div>
  <div class="field">
    <label class="label" for="class-examples-heading">Examples Heading</label>
    <div class="control">
      <input class="input" type="text" name="examples_heading" id="class-examples-heading" placeholder="e.g. Example Vanguards" value="{{class.examples_heading}}">
    </div>
  </div>
  <div class="field">
    <label class="label" for="class-examples">Examples</label>
    <div class="control">
      <textarea class="textarea" name="examples" id="class-examples" rows="5" placeholder="One example per line">{{#each class.examples}}{{this}}
{{/each}}</textarea>
    </div>
    <p class="help">One per line. Blank lines are dropped.</p>
  </div>
  <div class="field">
    <label class="checkbox">
      <input type="checkbox" name="is_public" {{#if class.is_public}}checked{{/if}}>
      Public (visible to everyone)
    </label>
  </div>
  <div class="field">
    <label class="label" for="class-tips-heading">Tips Heading</label>
    <div class="control">
      <input class="input" type="text" name="tips_heading" id="class-tips-heading" placeholder="e.g. Playing a Vanguard" value="{{class.tips_heading}}">
    </div>
  </div>
  <div class="field">
    <label class="label" for="class-tips">Tips (optional)</label>
    <div class="control">
      <textarea class="textarea" name="tips" id="class-tips" placeholder="Short gameplay tips shown under the description in the character creator wizard (optional)"
        data-toast-editor data-editor-height="150px">{{class.tips}}</textarea>
    </div>
  </div>
  <div class="field">
    <label class="label">Class Stats</label>
    <p class="help mb-2">Points the class pre-assigns at level 1. The character creator wizard uses these in step 2 (personality &amp; stat selection): the stats with points define which traits a player picks, and the points are auto-assigned. Most classes total 3 points; leave a stat at 0 to omit it.</p>
    <div class="columns is-multiline is-mobile">
      {{#each statList}}
      <div class="column is-2-tablet is-4-mobile">
        {{!-- A <div>, not a <label>: the stat is now a radiogroup of blocks,
              not a single labellable control, so a <label> here would have
              no `for` target and clicking it would move focus nowhere. The
              group carries its own aria-label. Bulma classes kept as-is --
              they carry this column's layout. --}}
        <div class="label is-small is-capitalized">{{this}}</div>
        <div class="control">
          {{> stat-blocks stat=this name=(concat "stat_spread[" this "]") value=(lookup ../class.stat_spread this) max=3}}
        </div>
      </div>
      {{/each}}
    </div>
    <div class="columns is-multiline">
      <div class="column is-half-tablet">
        <div class="field">
          <label class="label" for="class-stat-line">Stat Line</label>
          <div class="control">
            <input class="input" type="text" name="stat_line" id="class-stat-line" value="{{class.stat_line}}">
          </div>
          <p class="help">The stat allocation exactly as the pre-release document prints it.</p>
        </div>
      </div>
      <div class="column is-half-tablet">
        <div class="field">
          <label class="label" for="class-stat-note">Stat Note</label>
          <div class="control">
            <input class="input" type="text" name="stat_note" id="class-stat-note" value="{{class.stat_note}}">
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="field">
    <label class="label" for="class-image">Image</label>
    <div class="control">
      <input class="input" type="text" name="image_url" id="class-image" value="{{class.image_url}}">
    </div>
    <p class="help">Use a link to your image. We'll render it using the crop below without uploading.</p>
  </div>
  <div class="field">
    <label class="label">Image Crop &amp; Preview</label>
    <div class="profile-image-editor" data-image-cropper data-image-input="input[name='image_url']" data-crop-input="input[name='image_crop']">
      <div class="profile-image-editor__canvas">
        <img data-cropper-image src="{{class.image_url}}" alt="Class image cropper">
        <div class="profile-image-editor__placeholder" data-crop-placeholder {{#if class.image_url}}hidden{{/if}}>Add an image URL to start cropping</div>
      </div>
      <div class="profile-image-editor__preview" data-crop-preview aria-label="Class image preview"></div>
    </div>
    <input type="hidden" name="image_crop" value='{{{JSONstringify class.image_crop}}}'>
    <p class="help">Adjust the crop to control how this class art appears across the app.</p>
  </div>
  <div class="field">
    <label class="label" for="class-pdf">Class PDF (optional)</label>
    <div class="control">
      <input class="input" type="file" name="class_pdf" id="class-pdf" accept="application/pdf">
    </div>
    <p class="help">Upload a PDF to share full class rules. Max size 25MB.</p>
    {{#if class.pdf_storage_path}}
    <div class="mt-2">
      <p class="help">
        {{#if class.pdf_updated_at}}Last updated {{date_tz class.pdf_updated_at}}{{/if}}
        · <a href="/classes/{{class.id}}/pdf" target="_blank" rel="noopener">Preview current PDF</a>
      </p>
      <label class="checkbox">
        <input type="checkbox" name="remove_pdf">
        Remove existing PDF
      </label>
    </div>
    {{/if}}
  </div>
  {{!-- Repeatable Expanded Tips editor: two note-shaped lists, `player` and
        `conduit`, under one `expanded_tips[...]` root. It is its own x-data
        root and partial family rather than a parameterised reuse of the
        ability editor's note partials, for the same reason
        advanced_abilities is: the two roots' shared inner attribute names
        (data-child-row) can never be reached across a boundary this way (see
        renumberGearFields' comment in public/js/alpine-components.js), and
        the audience ('player' or 'conduit') is baked into each side's own
        prototype and list selector rather than threaded through a shared one.

        A tip is note-shaped -- text plus optional sub-bullets -- because
        util/class-expanded-tips.js normalizeExpandedTips runs every entry
        through the same normalizeNote util/class-gear.js already exports, so
        this editor is the ability/gear notes sub-editor promoted to a
        top-level repeater, twice, rather than a new shape.

        Unlike the ability, gear and advanced-ability lists there is no
        "starts on N blank rows" default: those three counts come from the
        source document (three Abilities, six or twelve Signatures, three
        Advanced Abilities), and no such count exists for an open-ended tip
        list. A class with none yet starts on zero rows in each list, with
        "Add tip" to grow it -- and since every live class's expanded_tips is
        still `{player: [], conduit: []}`, that also means the served markup
        carries no expanded_tips input at all until an admin adds one. --}}
  <div class="field" x-data="expandedTipsEditor()">
    {{#*inline "tipChildRow"}}
    <div class="field is-grouped mb-2" data-child-row>
      <div class="control is-expanded">
        <input class="input is-small" type="text" data-child-field="text" name="expanded_tips[{{audience}}][{{ti}}][children][{{ci}}][text]" value="{{child.text}}" placeholder="Sub-note" aria-label="Sub-note">
      </div>
      <div class="control">
        <button type="button" class="button is-small is-light" @click="removeChildTip($el, '{{audience}}')">Remove sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "tipRow"}}
    <div class="mb-3" data-tip-row>
      <div class="field is-grouped mb-2">
        <div class="control is-expanded">
          <input class="input" type="text" data-tip-field="text" name="expanded_tips[{{audience}}][{{ti}}][text]" value="{{tip.text}}" placeholder="Tip" aria-label="Tip">
        </div>
        <div class="control">
          <button type="button" class="button is-light" @click="removeTip($el, '{{audience}}')">Remove tip</button>
        </div>
      </div>
      <div class="pl-5">
        <div data-child-list>
          {{#each tip.children}}{{> tipChildRow child=this audience=../audience ti=../ti ci=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addChildTip($el, '{{audience}}')">Add sub-note</button>
      </div>
    </div>
    {{/inline}}
    <label class="label">Expanded Tips</label>
    <p class="help mb-3">The Player and Conduit tip lists from the class's last page.</p>

    <label class="label is-small">Player</label>
    <div data-tip-list="player">
      {{#each class.expanded_tips.player}}{{> tipRow tip=this audience="player" ti=@index}}{{/each}}
    </div>
    <button type="button" class="button is-small" @click="addTip('player')">Add player tip</button>

    <label class="label is-small mt-4">Conduit</label>
    <div data-tip-list="conduit">
      {{#each class.expanded_tips.conduit}}{{> tipRow tip=this audience="conduit" ti=@index}}{{/each}}
    </div>
    <button type="button" class="button is-small" @click="addTip('conduit')">Add conduit tip</button>

    {{!-- Inert prototypes; see the ability editor's note. A plain <template>
          keeps its children in a DocumentFragment, so Alpine's walker never
          enters it and the browser renders nothing. One prototype pair per
          audience, since the audience is baked into the row's names rather
          than passed at clone time. --}}
    <template data-prototype="tip-player">{{> tipRow audience="player" ti=0}}</template>
    <template data-prototype="tip-conduit">{{> tipRow audience="conduit" ti=0}}</template>
    <template data-prototype="child-player">{{> tipChildRow audience="player" ti=0 ci=0}}</template>
    <template data-prototype="child-conduit">{{> tipChildRow audience="conduit" ti=0 ci=0}}</template>
  </div>
  {{!-- Repeatable ability editor.

        THE ROWS ARE SERVER-RENDERED, NOT `<template x-for>`. This is
        load-bearing, for the reason partials/stat-blocks.handlebars records at
        length: views/layouts/main.handlebars puts hx-boost="true" on <body>,
        and htmx snapshots the LIVE DOM into its history cache, x-for output
        included. On Back the snapshot restores WITH those generated rows and
        Alpine's x-for appends a second full set, so two abilities come back as
        four, and the enlarged DOM is what gets snapshotted next -- the
        duplication compounds with every Back.

        Measured, so that nobody has to re-derive it: the stale half throws
        "ability is not defined" on every binding, because `ability` and `ai`
        live only in the x-for scope the restored markup has lost. It does NOT
        post duplicate names -- Alpine re-evaluates `:name`, the throw yields
        undefined, and Alpine REMOVES the attribute, so the stale controls
        contribute nothing to `abilities` (they surface, if at all, under an
        empty key no handler reads). The damage is to the editor rather than to
        the payload: the admin sees each ability twice, and half the rows are
        dead fields that accept typing and then post nothing.

        Real elements in the served HTML restore as themselves. Keep it that
        way.

        The same rule is why there is no x-model here: every value is a plain
        `value=`/inner-text attribute, so the fields are already correct in the
        raw HTML before Alpine runs, or if it never runs at all. Alpine only
        adds and removes rows; the `<template data-prototype>` blocks it clones
        are inert markup that nothing renders on its own.

        Plain textareas on purpose. _initToastUIEditors runs on page load and
        on htmx afterSwap only, so a row added later would get no editor at
        all, and ToastUI writes its value back through getMarkdown(), which
        reflows the verbatim prose this form copies from the source document.

        Nothing is `required`: a blank row is a normal intermediate state in a
        repeater, normalizeAbilities drops it server-side, and `required` on a
        row the admin just added blocks submission with no visible error
        anywhere near the field.

        The row markup lives in inline partials so that the prototype Alpine
        clones and the rows the server renders cannot drift apart. --}}
  <div class="field" x-data="abilityEditor()">
    {{#*inline "abilityMeterRow"}}
    <div class="field is-grouped mb-2" data-meter-row>
      <div class="control is-expanded">
        <input class="input" type="text" data-meter-field="label" name="abilities[{{ai}}][meters][{{mi}}][label]" value="{{meter.label}}" placeholder="Label, e.g. Essence Cost" aria-label="Meter label">
      </div>
      <div class="control is-expanded">
        <input class="input" type="text" data-meter-field="value" name="abilities[{{ai}}][meters][{{mi}}][value]" value="{{meter.value}}" placeholder="Value, e.g. Low" aria-label="Meter value">
      </div>
      <div class="control">
        <button type="button" class="button is-light" @click="removeMeter($el)">Remove meter</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "abilityNoteChildRow"}}
    <div class="field is-grouped mb-2" data-child-row>
      <div class="control is-expanded">
        <input class="input is-small" type="text" data-child-field="text" name="abilities[{{ai}}][notes][{{ni}}][children][{{ci}}][text]" value="{{child.text}}" placeholder="Sub-note" aria-label="Sub-note">
      </div>
      <div class="control">
        <button type="button" class="button is-small is-light" @click="removeChildNote($el)">Remove sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "abilityNoteRow"}}
    <div class="mb-3" data-note-row>
      <div class="field is-grouped mb-2">
        <div class="control is-expanded">
          <input class="input" type="text" data-note-field="text" name="abilities[{{ai}}][notes][{{ni}}][text]" value="{{note.text}}" placeholder="Note" aria-label="Note">
        </div>
        <div class="control">
          <button type="button" class="button is-light" @click="removeNote($el)">Remove note</button>
        </div>
      </div>
      <div class="pl-5">
        <div data-child-list>
          {{#each note.children}}{{> abilityNoteChildRow child=this ai=../ai ni=../ni ci=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addChildNote($el)">Add sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "abilityPerkRow"}}
    <div class="box is-shadowless has-background-light mb-2" data-perk-row>
      <div class="field is-grouped mb-2">
        <div class="control is-expanded">
          <input class="input is-small" type="text" data-perk-field="name" name="abilities[{{ai}}][sample_perks][{{pi}}][name]" value="{{perk.name}}" placeholder="Perk name" aria-label="Sample perk name">
        </div>
        <div class="control is-expanded">
          <input class="input is-small" type="text" data-perk-field="dedication" name="abilities[{{ai}}][sample_perks][{{pi}}][dedication]" value="{{perk.dedication}}" placeholder="Dedication (optional)" aria-label="Sample perk dedication">
        </div>
        <div class="control">
          <button type="button" class="button is-small is-light" @click="removePerk($el)">Remove perk</button>
        </div>
      </div>
      <div class="control mb-2">
        <textarea class="textarea is-small" rows="2" data-perk-field="text" name="abilities[{{ai}}][sample_perks][{{pi}}][text]" placeholder="Perk text" aria-label="Sample perk text">{{perk.text}}</textarea>
      </div>
      <div class="control">
        <textarea class="textarea is-small" rows="2" data-perk-field="compound_text" name="abilities[{{ai}}][sample_perks][{{pi}}][compound_text]" placeholder="Compounded variant (optional) — the full restated text, not just the addition" aria-label="Compounded perk text">{{perk.compound_text}}</textarea>
      </div>
    </div>
    {{/inline}}
    {{#*inline "abilityRow"}}
    <div class="box" data-ability-row>
      <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
        <span class="label mb-0" data-ability-heading>Ability {{add ai 1}}</span>
        <button type="button" class="button is-small is-danger is-light" @click="removeAbility($el)">Remove ability</button>
      </div>
      {{#if ability.pronunciation}}
      {{!-- No input edits a pronunciation guide and no view renders one, but
            two live abilities carry one. Round-tripping it here is what stops
            a routine save from deleting it. --}}
      <input type="hidden" data-field="pronunciation" name="abilities[{{ai}}][pronunciation]" value="{{ability.pronunciation}}">
      {{/if}}
      <div class="field">
        <label class="label is-small" data-label-for="name" for="ability-name-{{ai}}">Name</label>
        <div class="control">
          <input class="input" type="text" id="ability-name-{{ai}}" data-field="name" name="abilities[{{ai}}][name]" value="{{ability.name}}" placeholder="Ability name">
        </div>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="description" for="ability-description-{{ai}}">Description</label>
        <div class="control">
          <textarea class="textarea" rows="4" id="ability-description-{{ai}}" data-field="description" name="abilities[{{ai}}][description]" placeholder="What the ability does">{{ability.description}}</textarea>
        </div>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="paired_action" for="ability-paired-action-{{ai}}">Paired Action</label>
        <div class="control">
          <input class="input" type="text" id="ability-paired-action-{{ai}}" data-field="paired_action" name="abilities[{{ai}}][paired_action]" value="{{ability.paired_action}}" placeholder="The action this ability pairs with (optional)">
        </div>
      </div>
      <div class="field">
        <label class="label is-small">Meters</label>
        <div data-meter-list>
          {{#each ability.meters}}{{> abilityMeterRow meter=this ai=../ai mi=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addMeter($el)">Add meter</button>
      </div>
      <div class="field">
        <label class="label is-small">Notes</label>
        <div data-note-list>
          {{#each ability.notes}}{{> abilityNoteRow note=this ai=../ai ni=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addNote($el)">Add note</button>
      </div>
      <div class="field">
        <label class="label is-small">Sample Perks</label>
        <div data-perk-list>
          {{#each ability.sample_perks}}{{> abilityPerkRow perk=this ai=../ai pi=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addPerk($el)">Add sample perk</button>
      </div>
    </div>
    {{/inline}}
    <label class="label">Abilities</label>
    <p class="help mb-3">Meters, the paired action and the notes print on the class page exactly as they are entered here. An ability with no name is dropped on save, as is a meter missing either half of its pair and a note with no text.</p>
    <div data-ability-list>
      {{#if class.abilities.length}}
        {{#each class.abilities}}{{> abilityRow ability=this ai=@index}}{{/each}}
      {{else}}
        {{#times 3}}{{> abilityRow ai=@index}}{{/times}}
      {{/if}}
    </div>
    <button type="button" class="button" @click="addAbility()">Add ability</button>
    {{!-- Inert prototypes. A plain <template> keeps its children in a
          DocumentFragment, so Alpine's walker never enters it and the browser
          renders nothing -- which is also why a restored history snapshot
          brings these back as harmless markup rather than as a second set of
          live rows. --}}
    <template data-prototype="ability">{{> abilityRow ai=0}}</template>
    <template data-prototype="meter">{{> abilityMeterRow ai=0 mi=0}}</template>
    <template data-prototype="note">{{> abilityNoteRow ai=0 ni=0}}</template>
    <template data-prototype="child">{{> abilityNoteChildRow ai=0 ni=0 ci=0}}</template>
    <template data-prototype="perk">{{> abilityPerkRow ai=0 pi=0}}</template>
  </div>
  {{!-- Repeatable advanced-ability editor: the ability editor's twin over
        `advanced_abilities[...]` names, and every rule the ability editor's
        comment above records applies here unchanged and for the same measured
        reasons -- server-rendered rows, no Alpine-only source of truth, no
        input the admin must fill before the server can drop the row, plain
        textareas rather than ToastUI, and inert <template> prototypes.

        It is a separate x-data root with its own partials rather than a
        parameterised reuse of the ability partials, which hard-code the
        `abilities[...]` prefix in every name. Because the two roots are
        disjoint, the inner attribute names they share (data-meter-row,
        data-note-row, data-child-row, data-perk-row) can never be reached
        across a boundary -- the same argument renumberGearFields' comment in
        public/js/alpine-components.js records. Only the row and
        list markers differ, so that renumberAbilityFields and
        renumberAdvancedAbilityFields select different rows, and only the ids
        carry a distinct `advanced-ability-` prefix, since ids have to be
        unique across the whole document rather than within a root.

        routes/classes.js:675 and :747 run this column through the same
        normalizeAbilities as `abilities`, so a nameless row is dropped on
        save and an Advent class can leave all three blank. --}}
  <div class="field" x-data="advancedAbilityEditor()">
    {{#*inline "advancedAbilityMeterRow"}}
    <div class="field is-grouped mb-2" data-meter-row>
      <div class="control is-expanded">
        <input class="input" type="text" data-meter-field="label" name="advanced_abilities[{{ai}}][meters][{{mi}}][label]" value="{{meter.label}}" placeholder="Label, e.g. Essence Cost" aria-label="Meter label">
      </div>
      <div class="control is-expanded">
        <input class="input" type="text" data-meter-field="value" name="advanced_abilities[{{ai}}][meters][{{mi}}][value]" value="{{meter.value}}" placeholder="Value, e.g. Low" aria-label="Meter value">
      </div>
      <div class="control">
        <button type="button" class="button is-light" @click="removeMeter($el)">Remove meter</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "advancedAbilityNoteChildRow"}}
    <div class="field is-grouped mb-2" data-child-row>
      <div class="control is-expanded">
        <input class="input is-small" type="text" data-child-field="text" name="advanced_abilities[{{ai}}][notes][{{ni}}][children][{{ci}}][text]" value="{{child.text}}" placeholder="Sub-note" aria-label="Sub-note">
      </div>
      <div class="control">
        <button type="button" class="button is-small is-light" @click="removeChildNote($el)">Remove sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "advancedAbilityNoteRow"}}
    <div class="mb-3" data-note-row>
      <div class="field is-grouped mb-2">
        <div class="control is-expanded">
          <input class="input" type="text" data-note-field="text" name="advanced_abilities[{{ai}}][notes][{{ni}}][text]" value="{{note.text}}" placeholder="Note" aria-label="Note">
        </div>
        <div class="control">
          <button type="button" class="button is-light" @click="removeNote($el)">Remove note</button>
        </div>
      </div>
      <div class="pl-5">
        <div data-child-list>
          {{#each note.children}}{{> advancedAbilityNoteChildRow child=this ai=../ai ni=../ni ci=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addChildNote($el)">Add sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "advancedAbilityPerkRow"}}
    <div class="box is-shadowless has-background-light mb-2" data-perk-row>
      <div class="field is-grouped mb-2">
        <div class="control is-expanded">
          <input class="input is-small" type="text" data-perk-field="name" name="advanced_abilities[{{ai}}][sample_perks][{{pi}}][name]" value="{{perk.name}}" placeholder="Perk name" aria-label="Sample perk name">
        </div>
        <div class="control is-expanded">
          <input class="input is-small" type="text" data-perk-field="dedication" name="advanced_abilities[{{ai}}][sample_perks][{{pi}}][dedication]" value="{{perk.dedication}}" placeholder="Dedication (optional)" aria-label="Sample perk dedication">
        </div>
        <div class="control">
          <button type="button" class="button is-small is-light" @click="removePerk($el)">Remove perk</button>
        </div>
      </div>
      <div class="control mb-2">
        <textarea class="textarea is-small" rows="2" data-perk-field="text" name="advanced_abilities[{{ai}}][sample_perks][{{pi}}][text]" placeholder="Perk text" aria-label="Sample perk text">{{perk.text}}</textarea>
      </div>
      <div class="control">
        <textarea class="textarea is-small" rows="2" data-perk-field="compound_text" name="advanced_abilities[{{ai}}][sample_perks][{{pi}}][compound_text]" placeholder="Compounded variant (optional) — the full restated text, not just the addition" aria-label="Compounded perk text">{{perk.compound_text}}</textarea>
      </div>
    </div>
    {{/inline}}
    {{#*inline "advancedAbilityRow"}}
    <div class="box" data-advanced-row>
      <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
        <span class="label mb-0" data-ability-heading>Advanced Ability {{add ai 1}}</span>
        <button type="button" class="button is-small is-danger is-light" @click="removeAdvanced($el)">Remove advanced ability</button>
      </div>
      {{#if ability.pronunciation}}
      {{!-- The core editor's hidden round-trip field, for the same reason:
            normalizeAbilities echoes a pronunciation back only when the
            request carried one, so a routine save from a form that dropped it
            would delete it. --}}
      <input type="hidden" data-field="pronunciation" name="advanced_abilities[{{ai}}][pronunciation]" value="{{ability.pronunciation}}">
      {{/if}}
      <div class="field">
        <label class="label is-small" data-label-for="name" for="advanced-ability-name-{{ai}}">Name</label>
        <div class="control">
          <input class="input" type="text" id="advanced-ability-name-{{ai}}" data-field="name" name="advanced_abilities[{{ai}}][name]" value="{{ability.name}}" placeholder="Advanced ability name">
        </div>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="description" for="advanced-ability-description-{{ai}}">Description</label>
        <div class="control">
          <textarea class="textarea" rows="4" id="advanced-ability-description-{{ai}}" data-field="description" name="advanced_abilities[{{ai}}][description]" placeholder="What the ability does">{{ability.description}}</textarea>
        </div>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="paired_action" for="advanced-ability-paired-action-{{ai}}">Paired Action</label>
        <div class="control">
          <input class="input" type="text" id="advanced-ability-paired-action-{{ai}}" data-field="paired_action" name="advanced_abilities[{{ai}}][paired_action]" value="{{ability.paired_action}}" placeholder="The action this ability pairs with (optional)">
        </div>
      </div>
      <div class="field">
        <label class="label is-small">Meters</label>
        <div data-meter-list>
          {{#each ability.meters}}{{> advancedAbilityMeterRow meter=this ai=../ai mi=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addMeter($el)">Add meter</button>
      </div>
      <div class="field">
        <label class="label is-small">Notes</label>
        <div data-note-list>
          {{#each ability.notes}}{{> advancedAbilityNoteRow note=this ai=../ai ni=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addNote($el)">Add note</button>
      </div>
      <div class="field">
        <label class="label is-small">Sample Perks</label>
        <div data-perk-list>
          {{#each ability.sample_perks}}{{> advancedAbilityPerkRow perk=this ai=../ai pi=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addPerk($el)">Add sample perk</button>
      </div>
    </div>
    {{/inline}}
    <label class="label">Advanced Abilities</label>
    <p class="help mb-3">Aspirant classes have three. Unlocked with Perks rather than started with, so an Advent class leaves these blank.</p>
    <div data-advanced-list>
      {{#if class.advanced_abilities.length}}
        {{#each class.advanced_abilities}}{{> advancedAbilityRow ability=this ai=@index}}{{/each}}
      {{else}}
        {{#times 3}}{{> advancedAbilityRow ai=@index}}{{/times}}
      {{/if}}
    </div>
    <button type="button" class="button" @click="addAdvanced()">Add advanced ability</button>
    {{!-- Inert prototypes; see the ability editor's note. A plain <template>
          keeps its children in a DocumentFragment, so Alpine's walker never
          enters it and the browser renders nothing. --}}
    <template data-prototype="ability">{{> advancedAbilityRow ai=0}}</template>
    <template data-prototype="meter">{{> advancedAbilityMeterRow ai=0 mi=0}}</template>
    <template data-prototype="note">{{> advancedAbilityNoteRow ai=0 ni=0}}</template>
    <template data-prototype="child">{{> advancedAbilityNoteChildRow ai=0 ni=0 ci=0}}</template>
    <template data-prototype="perk">{{> advancedAbilityPerkRow ai=0 pi=0}}</template>
  </div>
  {{!-- Repeatable gear editor: the ability editor's twin, and every rule its
        comment above records applies here unchanged and for the same measured
        reasons -- server-rendered rows, no Alpine-only source of truth, no
        input the admin must fill before the server can drop the row, and plain
        textareas rather than ToastUI. views/class-form.test.js pins each of
        them over this section.

        The one field with no ability counterpart is `category`.
        views/class-view.handlebars splits Signature Gear into its Base and
        Elective columns by an exact string match on it, so the <select> offers
        exactly the two values normalizeGear accepts. Which option opens
        selected comes from the shared gearCategory helper rather than a second
        copy of the positional rule: util/class-import.js's AI path still writes
        gear with no category at all, and an uncategorised fourth item has to
        open on Elective here for the same reason it saves as Elective. --}}
  <div class="field" x-data="gearEditor()">
    {{#*inline "gearMeterRow"}}
    <div class="field is-grouped mb-2" data-meter-row>
      <div class="control is-expanded">
        <input class="input" type="text" data-meter-field="label" name="gear[{{gi}}][meters][{{mi}}][label]" value="{{meter.label}}" placeholder="Label, e.g. Accuracy Boost" aria-label="Meter label">
      </div>
      <div class="control is-expanded">
        <input class="input" type="text" data-meter-field="value" name="gear[{{gi}}][meters][{{mi}}][value]" value="{{meter.value}}" placeholder="Value, e.g. Mid" aria-label="Meter value">
      </div>
      <div class="control">
        <button type="button" class="button is-light" @click="removeMeter($el)">Remove meter</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "gearNoteChildRow"}}
    <div class="field is-grouped mb-2" data-child-row>
      <div class="control is-expanded">
        <input class="input is-small" type="text" data-child-field="text" name="gear[{{gi}}][notes][{{ni}}][children][{{ci}}][text]" value="{{child.text}}" placeholder="Sub-note" aria-label="Sub-note">
      </div>
      <div class="control">
        <button type="button" class="button is-small is-light" @click="removeChildNote($el)">Remove sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "gearNoteRow"}}
    <div class="mb-3" data-note-row>
      <div class="field is-grouped mb-2">
        <div class="control is-expanded">
          <input class="input" type="text" data-note-field="text" name="gear[{{gi}}][notes][{{ni}}][text]" value="{{note.text}}" placeholder="Note" aria-label="Note">
        </div>
        <div class="control">
          <button type="button" class="button is-light" @click="removeNote($el)">Remove note</button>
        </div>
      </div>
      <div class="pl-5">
        <div data-child-list>
          {{#each note.children}}{{> gearNoteChildRow child=this gi=../gi ni=../ni ci=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addChildNote($el)">Add sub-note</button>
      </div>
    </div>
    {{/inline}}
    {{#*inline "gearRow"}}
    <div class="box" data-gear-row>
      <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
        <span class="label mb-0" data-gear-heading>Gear {{add gi 1}}</span>
        <button type="button" class="button is-small is-danger is-light" @click="removeGear($el)">Remove gear</button>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="name" for="gear-name-{{gi}}">Name</label>
        <div class="control">
          <input class="input" type="text" id="gear-name-{{gi}}" data-field="name" name="gear[{{gi}}][name]" value="{{gear.name}}" placeholder="Gear name">
        </div>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="category" for="gear-category-{{gi}}">Column</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select id="gear-category-{{gi}}" data-field="category" name="gear[{{gi}}][category]">
              <option value="default" {{#if (eq (gearCategory gear.category gi) "default")}}selected{{/if}}>Base gear</option>
              <option value="elective" {{#if (eq (gearCategory gear.category gi) "elective")}}selected{{/if}}>Elective gear</option>
            </select>
          </div>
        </div>
      </div>
      <div class="field">
        <label class="label is-small" data-label-for="description" for="gear-description-{{gi}}">Description</label>
        <div class="control">
          <textarea class="textarea" rows="4" id="gear-description-{{gi}}" data-field="description" name="gear[{{gi}}][description]" placeholder="What the gear does">{{gear.description}}</textarea>
        </div>
      </div>
      <div class="field">
        <label class="label is-small">Meters</label>
        <div data-meter-list>
          {{#each gear.meters}}{{> gearMeterRow meter=this gi=../gi mi=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addMeter($el)">Add meter</button>
      </div>
      <div class="field">
        <label class="label is-small">Notes</label>
        <div data-note-list>
          {{#each gear.notes}}{{> gearNoteRow note=this gi=../gi ni=@index}}{{/each}}
        </div>
        <button type="button" class="button is-small" @click="addNote($el)">Add note</button>
      </div>
      {{!-- One object, not a list, so these carry data-enchantment-field
            rather than data-field: the [data-field] loop in
            renumberGearFields emits flat `gear[gi][key]` names, which would
            collapse the nesting. They carry no id, so no [data-label-for]
            pairing is needed. --}}
      <div class="field">
        <label class="label is-small">Default Enchantment</label>
        <p class="help mb-2">A Signature may hold only one Enchantment. Leave the name blank if this item has none.</p>
        <div class="control mb-2">
          <input class="input" type="text" data-enchantment-field="name" name="gear[{{gi}}][default_enchantment][name]" value="{{gear.default_enchantment.name}}" placeholder="Enchantment name, e.g. Hats Off to You" aria-label="Enchantment name">
        </div>
        <div class="control mb-2">
          <textarea class="textarea" rows="3" data-enchantment-field="description" name="gear[{{gi}}][default_enchantment][description]" placeholder="What the enchantment does" aria-label="Enchantment description">{{gear.default_enchantment.description}}</textarea>
        </div>
        <div class="control">
          <input class="input is-small" type="text" data-enchantment-field="dedication" name="gear[{{gi}}][default_enchantment][dedication]" value="{{gear.default_enchantment.dedication}}" placeholder="Dedication, e.g. In Honor of Crow" aria-label="Enchantment dedication">
        </div>
      </div>
    </div>
    {{/inline}}
    <label class="label">Signature Gear</label>
    <p class="help mb-3">Column decides where an item prints on the class page: Base gear every character of the class starts with, Elective gear they choose from. Meters and notes print exactly as they are entered here. A gear item with no name is dropped on save, as is a meter missing either half of its pair and a note with no text.</p>
    <div data-gear-list>
      {{#if class.gear.length}}
        {{#each class.gear}}{{> gearRow gear=this gi=@index}}{{/each}}
      {{else if (eq class.content_format "aspirant")}}
        {{#times 12}}{{> gearRow gi=@index}}{{/times}}
      {{else}}
        {{#times 6}}{{> gearRow gi=@index}}{{/times}}
      {{/if}}
    </div>
    <button type="button" class="button" @click="addGear()">Add gear</button>
    {{!-- Inert prototypes; see the ability editor's note. A plain <template>
          keeps its children in a DocumentFragment, so Alpine's walker never
          enters it and the browser renders nothing. --}}
    <template data-prototype="gear">{{> gearRow gi=0}}</template>
    <template data-prototype="meter">{{> gearMeterRow gi=0 mi=0}}</template>
    <template data-prototype="note">{{> gearNoteRow gi=0 ni=0}}</template>
    <template data-prototype="child">{{> gearNoteChildRow gi=0 ni=0 ci=0}}</template>
  </div>
  <div class="field">
    <div class="control">
      <button class="button is-primary" type="submit">Save</button>
    </div>
  </div>
  </form>
