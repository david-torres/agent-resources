<div class="column is-one-third">
  <div class="field has-addons">
    <div class="control is-expanded">
      <select name="gear[]" required data-searchable-select>
        <option value="">Select signature gear...</option>
        {{#each classGearList}}
        <optgroup label="{{capitalize name}}">
          {{#each items}}
          <option value="{{@../key}}::{{this}}" {{#if (and (eq this (lookup ../../characterGear 'name')) (eq @../key (lookup ../../characterGear 'class_id')))}}selected{{/if}}>{{capitalize this}} ({{capitalize ../name}} — {{#if (lt @index ../../adventDefaultSignatures)}}Base{{else}}Elective{{/if}})</option>
          {{/each}}
        </optgroup>
        {{/each}}
      </select>
    </div>
    <div class="control ml-2 mt-2">
      <button class="delete" hx-on:click="htmx.remove(htmx.closest(this, '.is-one-third'));"></button>
    </div>
  </div>
</div>
