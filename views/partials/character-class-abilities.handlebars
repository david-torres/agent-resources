<div class="column is-one-third">
  <div class="field has-addons">
    <div class="control is-expanded">
      <select name="abilities[]" required data-searchable-select>
        <option value="">Select ability...</option>
        {{#each classAbilityList}}
        <optgroup label="{{capitalize name}}">
          {{#each items}}
          <option value="{{@../key}}::{{this.name}}::{{this.type}}" {{#if (and (eq this.name (lookup ../../characterAbility 'name')) (eq @../key (lookup ../../characterAbility 'class_id')))}}selected{{/if}}>{{capitalize this.name}} ({{capitalize ../name}}{{#if (eq this.type 'advanced')}} — Advanced{{/if}})</option>
          {{/each}}
        </optgroup>
        {{/each}}
      </select>
    </div>
    <div class="control ml-2 mt-2">
      <button class="delete" hx-on:click="htmx.remove(htmx.closest(this, '.is-one-third'));"></button>
    </div>
  </div>
</div>