<form hx-post="/lfg/{{post.id}}/join" hx-swap="outerHTML" class="box" x-data="{ joinType: 'player' }">
  <h3 class="title is-4">Join "{{post.title}}"</h3>
  <p>Date: {{date_tz post.date "dddd, MMMM Do YYYY, h:mm A" profile.timezone}}</p>
  <p>Created by: {{#if post.creator_is_public}}<a href="/profile/view/{{encodeURIComponentH post.creator_name}}">{{post.creator_name}}</a>{{else}}{{post.creator_name}}{{/if}}</p>

  <div class="field">
    <label class="label">Join as:</label>
    <div class="control">
      <label class="radio">
        <input type="radio" name="joinType" value="player" id="join-player-opt" x-model="joinType">
        Player
      </label>
      <label class="radio">
        <input type="radio" name="joinType" value="conduit" x-model="joinType" {{#if post.host_id}}disabled{{/if}}>
        Conduit {{#if post.host_id}}(Already assigned){{/if}}
      </label>
    </div>
  </div>

  <div class="field" id="character-select" x-show="joinType === 'player'">
    <label class="label">Select Character:</label>
    <div class="control">
      <div class="select">
        <select name="characterId" required>
          <option disabled>Select a character</option>
          {{#each characters}}
            <option value="{{this.id}}">{{this.name}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </div>

  <div class="field is-grouped mt-4">
    <div class="control">
      <button class="button is-primary" type="submit" hx-indicator="this">Request to Join</button>
    </div>
    <div class="control">
      <button class="button is-light" hx-get="/lfg/{{post.id}}" hx-target="body">Cancel</button>
    </div>
  </div>
</form>