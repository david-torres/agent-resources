<div id="v2-fields-container">
  <hr />

  <div class="block">
    <label class="label">Defining Quirk</label>
    <p class="help mb-2">Optional, and most characters have none: an unusual trait essential to your character's identity. Limited to one, and it must be more downside than upside.</p>
    <div class="field">
      <div class="control">
        <input class="input" type="text" name="quirk_name" value="{{character.quirks.[0].name}}" placeholder="Quirk name (e.g. Monochromia)">
      </div>
    </div>
    <div class="field">
      <div class="control">
        <input class="input" type="text" name="quirk_downside" value="{{character.quirks.[0].downside}}" placeholder="Downside (required with a name)">
      </div>
    </div>
    <div class="field">
      <div class="control">
        <input class="input" type="text" name="quirk_upside" value="{{character.quirks.[0].upside}}" placeholder="Upside (optional)">
      </div>
    </div>
  </div>

  <hr />

  <div class="block">
    <label class="label">Accessories</label>
    <div class="columns is-multiline" id="accessories-list">
      {{#if character.accessories}}
        {{#each character.accessories}}
          {{> character-accessory accessory=this}}
        {{/each}}
      {{/if}}
    </div>
    <button type="button" class="button is-primary"
            hx-get="/characters/accessory" hx-target="#accessories-list" hx-swap="beforeend">Add Accessory</button>
  </div>

  <hr />

  <div class="block">
    <label class="label">Ability Perks</label>
    <p class="help mb-2">Each perk is at most {{perkFigures.perkWordLimit}} words; max {{perkFigures.perksPerAbility}} per ability. A perk's optional name doesn't count toward its word limit. Use the "Compounds with" picker to stack a perk onto another perk for the same ability.</p>
    <div id="perk-groups">
      {{#each character.abilities}}
        {{> character-perk-group linkValue=this.id domKey=this.id abilityName=this.name abilityPerks=../character.ability_perks perkFigures=../perkFigures}}
      {{/each}}
    </div>
    <p id="perk-groups-empty" class="has-text-grey"{{#if character.abilities.length}} hidden{{/if}}>Add at least one Class Ability above before authoring perks.</p>
  </div>
</div>
