{{> breadcrumbs}}
<h1 class="title is-2">Classes</h1>
{{#if profile}}
<div class="buttons is-right">
  <button class="button is-light" id="importClassBtn" hx-get="/classes/import"
      hx-target="body" hx-swap="innerHTML" hx-push-url="/classes/import">Import Class</button>
  <button class="button is-primary" id="createClassBtn" hx-get="/classes/new"
      hx-target="body" hx-swap="innerHTML" hx-push-url="/classes/new">Create Class</button>
</div>
{{/if}}

<!-- Filters -->
<div class="card mb-4">
  <div class="card-content">
    <h5 class="title is-5">Filters</h5>
    <form id="filterForm">
      <div class="columns is-multiline">
        <div class="column is-3">
          <div class="field">
            <label class="label" for="rulesEdition">Rules Edition</label>
            <div class="control">
              <div class="select is-fullwidth">
                <select id="rulesEdition" name="rules_edition">
                  <option value="" {{#if (eq filters.rules_edition '' )}}selected{{/if}}>All</option>
                  <option value="advent" {{#if (eq filters.rules_edition 'advent' )}}selected{{/if}}>Advent</option>
                  <option value="aspirant" {{#if (eq filters.rules_edition 'aspirant' )}}selected{{/if}}>Aspirant</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="column is-3">
          <div class="field">
            <label class="label" for="rulesVersion">Rules Version</label>
            <div class="control">
              <div class="select is-fullwidth">
                <select id="rulesVersion" name="rules_version">
                  <option value="" {{#if (eq filters.rules_version '' )}}selected{{/if}}>All</option>
                  <option value="v1" {{#if (eq filters.rules_version 'v1' )}}selected{{/if}}>v1</option>
                  <option value="v2" {{#if (eq filters.rules_version 'v2' )}}selected{{/if}}>v2</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="column is-3">
          <div class="field">
            <label class="label" for="isPlayerCreated">Type</label>
            <div class="control">
              <div class="select is-fullwidth">
                <select id="isPlayerCreated" name="is_player_created">
                  <option value="" {{#if (eq filters.is_player_created '' )}}selected{{/if}}>All</option>
                  <option value="false" {{#if (eq filters.is_player_created false)}}selected{{/if}}>Official</option>
                  <option value="true" {{#if (eq filters.is_player_created true)}}selected{{/if}}>Player Created
                  </option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="column is-3">
          <div class="field">
            <label class="label" for="status">Status</label>
            <div class="control">
              <div class="select is-fullwidth">
                <select id="status" name="status">
                  <option value="" {{#if (eq filters.status '' )}}selected{{/if}}>All</option>
                  <option value="release" {{#if (eq filters.status 'release' )}}selected{{/if}}>Release</option>
                  <option value="beta" {{#if (eq filters.status 'beta' )}}selected{{/if}}>Beta</option>
                  <option value="alpha" {{#if (eq filters.status 'alpha' )}}selected{{/if}}>Alpha</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="column is-12">
          <div class="field is-grouped">
            <div class="control">
              <button type="submit" class="button is-primary">Apply Filters</button>
            </div>
            <div class="control">
              <button type="button" class="button is-light" id="resetFilters" hx-get="/classes" hx-target="body"
                hx-swap="innerHTML" hx-on:click="htmx.closest(this, 'form').reset()"
                hx-push-url="/classes">Reset</button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Class List -->
{{#*inline "class-difficulty-buckets"}}
<div id="{{listId}}" class="block">
  {{#each buckets}}
  {{#unless (and (eq ../buckets.length 1) (eq level 'unrated'))}}
  <h3 class="title is-6 mb-3">{{label}}</h3>
  {{/unless}}
  <div class="columns is-multiline">
    {{#each groups}}
    {{> class-group-card this showImage=../../showImage locked=../../locked}}
    {{/each}}
  </div>
  {{/each}}
</div>
{{/inline}}
{{#if ownedReleaseGroups.length}}
{{> section-heading tag="h2" class="title is-4" id="owned-released-classes" title="Your Released Classes"}}
{{#if (gt ownedEditions.length 1)}}
<div class="buttons has-addons mb-3" id="ownedEditionToggle" role="group" aria-label="Rules">
  <a href="{{ownedToggleLinks.advent}}" class="button is-small{{#if (eq ownedEdition 'advent')}} is-primary is-selected{{/if}}"{{#if (eq ownedEdition 'advent')}} aria-current="true"{{/if}}>Advent</a>
  <a href="{{ownedToggleLinks.aspirant}}" class="button is-small{{#if (eq ownedEdition 'aspirant')}} is-success is-selected{{/if}}"{{#if (eq ownedEdition 'aspirant')}} aria-current="true"{{/if}}>Aspirant</a>
</div>
{{/if}}
{{> class-difficulty-buckets buckets=ownedReleaseGroups listId="classList" showImage=true}}
{{/if}}

{{#each lockedSections}}
<section class="block locked-edition" data-locked-edition="{{edition}}">
  <h2 class="title is-4" id="locked-{{edition}}-classes">
    <span class="icon has-text-grey"><i class="fas fa-lock"></i></span>
    <span>Locked — {{edition_label edition}}</span>
    <span class="tag is-light ml-2">{{count}} {{#if (eq count 1)}}class{{else}}classes{{/if}}</span>
  </h2>
  {{#if trialEndedAt}}
  <p class="has-text-danger mb-2">{{> access/trial-ended-text edition=edition endedAt=trialEndedAt lead=null}}</p>
  {{/if}}
  {{> access/unlock-cta edition=edition}}
  {{> class-difficulty-buckets buckets=buckets listId=(concat "locked-" edition "-list") locked=true}}
</section>
{{/each}}

{{#if exclusiveGroups.length}}
<section class="block" data-exclusive-classes>
  <h2 class="title is-4" id="exclusive-classes">
    <span class="icon has-text-grey"><i class="fas fa-lock"></i></span>
    <span>Exclusive Classes</span>
  </h2>
  <div class="buttons mt-2 access-unlock-cta">
    <a class="button is-light" href="/classes/redeem/bulk">Redeem a code</a>
  </div>
  {{> class-difficulty-buckets buckets=exclusiveGroups listId="exclusiveClassList" locked=true}}
</section>
{{/if}}

{{#if otherReleaseGroups.length}}
{{> section-heading tag="h2" class="title is-4" id="released-classes" title="Other Released Classes"}}
{{> class-difficulty-buckets buckets=otherReleaseGroups listId="otherClassList"}}
{{/if}}

{{#if prereleaseGroups.length}}
{{> section-heading tag="h2" class="title is-4" id="prerelease-classes" title="Pre-release Classes"}}
{{> class-difficulty-buckets buckets=prereleaseGroups listId="prereleaseClassList"}}
{{/if}}

{{#if pccGroups.length}}
{{> section-heading tag="h2" class="title is-4" id="player-created-classes" title="Player-Created Classes (PCCs)"}}
{{> class-difficulty-buckets buckets=pccGroups listId="pccClassList"}}
{{/if}}
