# Supabase variables
SUPABASE_URL=https://DUMMYURL.supabase.co
SUPABASE_PUBLISHABLE_KEY=DUMMY_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=DUMMY_SECRET_KEY
SUPABASE_DB_PASS=DUMMY_PASSWORD
# Pooler region; only set if your project is not in us-east-1.
SUPABASE_DB_REGION=aws-0-us-east-1

# Canonical public origin, used for the absolute <loc> URLs in /sitemap.xml.
# Optional: unset, the sitemap falls back to the request's own scheme and Host.
# Set it in production, where TLS terminates at a proxy and the app sees http.
SITE_URL=https://agent-resources.vip

# OpenAI API key. Parsing user provided text into game classes,
# characters, and missions will not work without a key.
OPENAI_API_KEY=sk-proj-DUMMYKEY

# System message variables
# TODO: move SYSTEM_MESSAGE_* variables to config.json or the database
# because they are not deploy-time configurations. They are used in the
# application code to display a web banner.
SYSTEM_MESSAGE_ENABLED=true
SYSTEM_MESSAGE_ID=123
# value one of: info, warning, danger, success
SYSTEM_MESSAGE_LEVEL=info
SYSTEM_MESSAGE_TEXT="Dummy message"

# GitHub issue reporting. The in-app bug report / feature request widget is
# only rendered, and its endpoint only answers, when GITHUB_TOKEN is set.
# Use a fine-grained personal access token scoped to GITHUB_ISSUE_REPO with
# Issues: read and write -- nothing else.
GITHUB_TOKEN=github_pat_DUMMYTOKEN
# Repository that in-app reports are filed against. Defaults to
# david-torres/agent-resources when unset.
GITHUB_ISSUE_REPO=david-torres/agent-resources
