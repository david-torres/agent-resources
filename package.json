{
  "name": "agent-resources",
  "version": "1.0.0",
  "description": "Agent Resources: is a web application for managing Enclave characters, finding games, and more!",
  "main": "index.js",
  "scripts": {
    "start": "bun run index.js",
    "dev": "bun --watch index.js",
    "test": "bun run test:unit",
    "test:unit": "bun scripts/run-tests.mjs unit",
    "test:http": "bun scripts/run-tests.mjs http",
    "test:integration": "bun scripts/run-tests.mjs integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "bun scripts/check.mjs",
    "setup": "bun run scripts/setup.mjs",
    "seed:local": "bun run scripts/seed-local.mjs",
    "seed:classes": "bun run util/seed-classes.js",
    "seed:rules": "bun run util/seed-rules-pdfs.js",
    "seed:admin": "bun run util/seed-admin.js",
    "seed:badges": "bun run scripts/seed-badges.js",
    "seed:test:advanced-abilities": "bun run scripts/seed-test-advanced-abilities.js",
    "fetch:badges": "bun run scripts/fetch-badge-art.js",
    "db:backup": "sh scripts/db-backup.sh",
    "rehearse:migrations": "bash scripts/rehearse-migrations.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "calendar-link": "^2.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-handlebars": "^8.0.1",
    "handlebars-helper-range": "^1.1.1",
    "handlebars-helpers": "^0.10.0",
    "llm-api": "^1.6.0",
    "marked": "^18.0.1",
    "moment-timezone": "^0.5.46",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.17.3",
    "zod-gpt": "^0.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "alpinejs": "3.15.12",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.7",
    "pg": "^8.21.0"
  }
}
